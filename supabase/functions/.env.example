# Copy to supabase/functions/.env for `supabase functions serve` (never commit .env).
# Hosted: supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Max Gemini calls per function per hour (protects the free quota during demos)
AI_HOURLY_LIMIT=60
